{
  "name": "@my-noodles/utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint-check": "oxlint",
    "type-check": "tsc --noEmit -p tsconfig.json"
  }
}
