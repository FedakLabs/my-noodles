{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ui/src",
  "projectType": "library",
  "tags": ["scope:packages", "type:lib", "platform:web"],
  "targets": {
    "build": {
      "command": "pnpm build",
      "options": {
        "cwd": "packages/ui"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "format": {
      "command": "pnpm format",
      "options": {
        "cwd": "packages/ui"
      }
    },
    "format-check": {
      "command": "pnpm format-check",
      "options": {
        "cwd": "packages/ui"
      }
    },
    "lint": {
      "command": "pnpm lint",
      "options": {
        "cwd": "packages/ui"
      }
    },
    "lint-check": {
      "command": "pnpm lint-check",
      "options": {
        "cwd": "packages/ui"
      }
    },
    "type-check": {
      "command": "pnpm type-check",
      "options": {
        "cwd": "packages/ui"
      }
    },
    "test": {
      "command": "pnpm test",
      "options": {
        "cwd": "packages/ui"
      }
    },
    "storybook": {
      "command": "pnpm storybook",
      "options": {
        "cwd": "packages/ui"
      }
    },
    "build-storybook": {
      "command": "pnpm build-storybook",
      "options": {
        "cwd": "packages/ui"
      },
      "outputs": ["{projectRoot}/dist/storybook"]
    },
    "knip": {},
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "commands": [
          "nx run ui:format",
          "nx run ui:lint",
          "nx run ui:type-check",
          "nx run ui:test",
          "nx run ui:knip"
        ],
        "parallel": false
      }
    }
  }
}
