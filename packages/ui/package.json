{
  "name": "@my-noodles/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons/*.svg": "./src/icons/*.svg",
    "./types": {
      "types": "./types/index.d.ts",
      "default": "./types/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint-check": "oxlint",
    "type-check": "tsc --noEmit -p tsconfig.lib.json",
    "test": "vitest run",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build -o dist/storybook"
  },
  "dependencies": {
    "@my-noodles/locale": "workspace:*",
    "@my-noodles/theme": "workspace:*",
    "@my-noodles/web-lib": "workspace:*",
    "dayjs": "^1.11.21",
    "embla-carousel-react": "^8.6.0",
    "mui-tel-input": "^11.0.0",
    "react-day-picker": "^10.0.1",
    "sonner": "^2.0.7"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/material": "^9.0.0",
    "@tanstack/react-table": "8.21.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@mui/material": "9.1.1",
    "@my-noodles/vite-config": "workspace:*",
    "@my-noodles/vitest-config": "workspace:*",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@tanstack/react-table": "8.21.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "10.4.6",
    "vite": "8.0.16",
    "vite-plugin-svgr": "4.5.0",
    "vitest": "4.1.9"
  }
}
