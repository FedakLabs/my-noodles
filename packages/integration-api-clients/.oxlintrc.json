{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "ignorePatterns": ["**/generated/**"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/apps/**"],
            "message": "Packages must not import apps (@nx/enforce-module-boundaries replacement)."
          }
        ]
      }
    ]
  }
}
