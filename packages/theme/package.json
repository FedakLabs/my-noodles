    "@storybook/addon-docs": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "10.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "10.4.6",
    "vite": "8.0.16",
    "vitest": "4.1.9"
