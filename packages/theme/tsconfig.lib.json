{
  "extends": "../../configs/typescript/base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "src/stories", "src/**/~*.test.ts", "src/**/*.{test,spec}.ts"]
}
