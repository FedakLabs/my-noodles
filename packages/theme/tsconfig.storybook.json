{
  "extends": "../../configs/typescript/base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/.storybook-types",
    "rootDir": "."
  },
  "references": [{ "path": "./tsconfig.lib.json" }],
  "include": [
    "src/css.d.ts",
    "src/stories/**/*.ts",
    "src/stories/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
