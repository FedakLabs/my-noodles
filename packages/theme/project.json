{
  "name": "theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/theme/src",
  "projectType": "library",
  "tags": ["scope:packages", "type:lib"],
  "targets": {
    "build": {
      "command": "pnpm build",
      "options": {
        "cwd": "packages/theme"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "format": {
      "command": "pnpm format",
      "options": {
        "cwd": "packages/theme"
      }
    },
    "format-check": {
      "command": "pnpm format-check",
      "options": {
        "cwd": "packages/theme"
      }
    },
    "lint": {
      "command": "pnpm lint",
      "options": {
        "cwd": "packages/theme"
      }
    },
    "lint-check": {
      "command": "pnpm lint-check",
      "options": {
        "cwd": "packages/theme"
      }
    },
    "type-check": {
      "command": "pnpm type-check",
      "options": {
        "cwd": "packages/theme"
      }
    },
    "test": {
      "command": "pnpm test",
      "options": {
        "cwd": "packages/theme"
      }
    },
    "knip": {
      "command": "knip --config configs/knip/knip.json --workspace packages/theme",
      "options": {
        "cwd": "."
      }
    },
    "storybook": {
      "command": "pnpm storybook",
      "options": {
        "cwd": "packages/theme"
      }
    },
    "build-storybook": {
      "command": "pnpm build-storybook",
      "options": {
        "cwd": "packages/theme"
      },
      "outputs": ["{projectRoot}/dist/storybook"]
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run {projectName}:format",
          "nx run {projectName}:lint",
          "nx run {projectName}:type-check",
          "nx run {projectName}:test",
          "nx run {projectName}:knip"
        ],
        "parallel": false
      }
    }
  }
}
