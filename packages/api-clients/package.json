{
  "name": "@my-noodles/api-clients",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./storefront": {
      "types": "./dist/src/storefront/index.d.ts",
      "import": "./src/storefront/index.ts",
      "default": "./src/storefront/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "api:generate": "openapi-ts -f ./openapi-ts.config.ts",
    "format": "prettier --write . --ignore-path ../../configs/prettier/.prettierignore",
    "format-check": "prettier --check . --ignore-path ../../configs/prettier/.prettierignore",
    "lint": "eslint . --fix",
    "lint-check": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.2",
    "@my-noodles/eslint-config": "workspace:*",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8"
  }
}
