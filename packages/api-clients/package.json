{
  "name": "@my-noodles/api-clients",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./storefront": {
      "types": "./dist/src/storefront/index.d.ts",
      "import": "./src/storefront/index.ts",
      "default": "./src/storefront/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "api:generate": "openapi-generator-cli generate -c ./src/storefront/openapi-generator.json -o ./src/storefront/generated"
  },
  "dependencies": {
    "axios": "1.9.0"
  },
  "devDependencies": {
    "@my-noodles/eslint-config": "workspace:*",
    "@openapitools/openapi-generator-cli": "2.38.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8"
  }
}
