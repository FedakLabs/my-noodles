{
  "name": "@my-noodles/api-clients",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "require": {
        "types": "./dist/cjs/src/index.d.ts",
        "default": "./dist/cjs/src/index.js"
      }
    },
    "./storefront": {
      "import": {
        "types": "./src/storefront/index.ts",
        "default": "./src/storefront/index.ts"
      },
      "require": {
        "types": "./dist/cjs/src/storefront/index.d.ts",
        "default": "./dist/cjs/src/storefront/index.js"
      }
    },
    "./admin": {
      "import": {
        "types": "./src/admin/index.ts",
        "default": "./src/admin/index.ts"
      },
      "require": {
        "types": "./dist/cjs/src/admin/index.d.ts",
        "default": "./dist/cjs/src/admin/index.js"
      }
    },
    "./auth": {
      "import": {
        "types": "./src/auth/index.ts",
        "default": "./src/auth/index.ts"
      },
      "require": {
        "types": "./dist/cjs/src/auth/index.d.ts",
        "default": "./dist/cjs/src/auth/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "api:generate": "openapi-ts -f ./src/storefront/openapi-ts.config.ts && openapi-ts -f ./src/admin/openapi-ts.config.ts && openapi-ts -f ./src/auth/openapi-ts.config.ts",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint-check": "oxlint",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@my-noodles/locale": "workspace:*"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.2"
  }
}
