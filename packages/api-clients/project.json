{
  "name": "api-clients",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/api-clients/src",
  "projectType": "library",
  "tags": ["scope:packages", "type:lib"],
  "targets": {
    "api:generate": {
      "command": "pnpm api:generate",
      "options": {
        "cwd": "packages/api-clients"
      }
    },
    "build": {
      "command": "pnpm build",
      "options": {
        "cwd": "packages/api-clients"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "format": {
      "command": "pnpm format",
      "options": {
        "cwd": "packages/api-clients"
      }
    },
    "format-check": {
      "command": "pnpm format-check",
      "options": {
        "cwd": "packages/api-clients"
      }
    },
    "lint": {
      "command": "pnpm lint",
      "options": {
        "cwd": "packages/api-clients"
      }
    },
    "lint-check": {
      "command": "pnpm lint-check",
      "options": {
        "cwd": "packages/api-clients"
      }
    },
    "type-check": {
      "command": "pnpm type-check",
      "options": {
        "cwd": "packages/api-clients"
      }
    },
    "knip": {
      "command": "knip --config configs/knip/knip.json --workspace packages/api-clients",
      "options": {
        "cwd": "."
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run {projectName}:format",
          "nx run {projectName}:lint",
          "nx run {projectName}:type-check",
          "nx run {projectName}:knip"
        ],
        "parallel": false
      }
    }
  }
}
