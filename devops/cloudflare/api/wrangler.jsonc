{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "my-noodles-api-unconfigured",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": false,
  "observability": {
    "enabled": true,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "Dockerfile",
      "image_build_context": "../../../",
      "max_instances": 1,
      "ssh": {
        "enabled": true,
      },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "API_CONTAINER", "class_name": "ApiContainer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }],
}
