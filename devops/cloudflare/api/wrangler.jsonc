{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "my-noodles-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "../../../apps/api/Dockerfile",
      "image_build_context": "../../../",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "API_CONTAINER", "class_name": "ApiContainer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }],
  "routes": [{ "pattern": "api.mynoodles.shop", "custom_domain": true }],
}
