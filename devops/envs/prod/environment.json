{
  "cloudflare": {
    "web": {
      "workerName": "my-noodles-web",
      "domains": ["mynoodles.shop", "www.mynoodles.shop"]
    },
    "admin": {
      "workerName": "my-noodles-admin",
      "domains": ["admin.mynoodles.shop"]
    },
    "api": {
      "workerName": "my-noodles-api",
      "domains": ["api.mynoodles.shop"]
    }
  },
  "applications": {
    "web": {
      "NEXT_PUBLIC_API_URL": "https://api.mynoodles.shop",
      "NEXT_PUBLIC_SITE_URL": "https://mynoodles.shop"
    },
    "admin": {
      "ADMIN_PUBLIC_URL": "https://admin.mynoodles.shop",
      "VITE_API_URL": "https://api.mynoodles.shop",
      "VITE_AUTH_API_URL": "https://api.mynoodles.shop"
    },
    "api": {
      "API_PUBLIC_URL": "https://api.mynoodles.shop",
      "OTEL_ENABLED": "true",
      "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
      "OTEL_RESOURCE_ATTRIBUTES": "deployment.environment.name=production,service.namespace=my-noodles",
      "OTEL_SERVICE_NAME": "my-noodles-api"
    }
  }
}
