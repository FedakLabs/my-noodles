#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - docker.io
  - docker-compose-v2

runcmd:
  - systemctl enable --now docker
  - mkdir -p ${deploy_path}/certs
  - chmod 750 ${deploy_path}

final_message: "my-noodles app node ready — sync compose/Caddyfile/certs and deploy images"
