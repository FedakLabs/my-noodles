# Copied to /opt/my-noodles/.env on the app VM (never commit real values).
# App local templates: apps/api/.env.example, apps/web/.env.example
# GH Environment prod inventory: devops/docs/secrets.md

GHCR_OWNER=your-github-org-or-user
WEB_IMAGE_TAG=sha-0000000
API_IMAGE_TAG=sha-0000000

# Neon pooled (runtime) — include connect_timeout=10&sslmode=require&channel_binding=require
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=10

APP_NAME=my-noodles-api
APP_VERSION=prod
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TAWK_API_KEY=
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=
NOVA_POSHTA_API_KEY=

# Keep false until OTEL_EXPORTER_OTLP_ENDPOINT is set (API Config requires it when enabled).
# OTEL_EXPORTER_OTLP_HEADERS is for the OTEL SDK (Grafana auth); Nest Config does not validate it.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=my-noodles-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Keep false until SENTRY_DSN is set (API Config requires it when enabled).
SENTRY_ENABLED=false
SENTRY_DSN=

# Object storage / CDN — on VM env for api; Nest does not read these yet (infra-ready).
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=my-noodles-media
CDN_PUBLIC_BASE_URL=https://cdn.mynoodles.shop

# Storefront (baked at web image build time — also set as build-args in deploy-web)
# NEXT_PUBLIC_API_URL=https://api.mynoodles.shop
# NEXT_PUBLIC_SITE_URL=https://mynoodles.shop
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=
