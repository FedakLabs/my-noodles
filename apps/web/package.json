{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write . --ignore-path ../../configs/prettier/.prettierignore",
    "format-check": "prettier --check . --ignore-path ../../configs/prettier/.prettierignore",
    "lint": "eslint . --fix",
    "lint-check": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "generate:clients": "nx run api-clients:api:generate"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@hookform/resolvers": "5.4.0",
    "@mui/material": "9.1.1",
    "@mui/material-nextjs": "9.1.1",
    "@my-noodles/api-clients": "workspace:*",
    "@my-noodles/theme": "workspace:*",
    "@my-noodles/ui": "workspace:*",
    "@my-noodles/web-lib": "workspace:*",
    "@next/third-parties": "16.2.9",
    "@tanstack/react-query": "5.101.0",
    "next": "16.2.9",
    "next-intl": "4.13.0",
    "nuqs": "2.8.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.79.0",
    "server-only": "0.0.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@my-noodles/eslint-config": "workspace:*",
    "@my-noodles/vitest-config": "workspace:*",
    "@svgr/webpack": "8.1.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "vitest": "4.1.9"
  }
}
