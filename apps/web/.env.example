# Copy to `.env.local` (gitignored). Restart `next dev` after changes.

# Required
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — analytics off when unset (GA4 Measurement ID + Hotjar Site ID live in GTM only)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Optional — browser error reporting off when unset
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Optional — Sentry release tag (CI sets from git sha)
# NEXT_PUBLIC_APP_VERSION=dev
