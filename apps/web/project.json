{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": ["scope:web", "type:app"],
  "targets": {
    "dev": {
      "command": "next dev",
      "options": {
        "cwd": "apps/web"
      }
    },
    "build": {
      "command": "next build",
      "options": {
        "cwd": "apps/web"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "format": {
      "command": "prettier --write .",
      "options": {
        "cwd": "apps/web"
      }
    },
    "format-check": {
      "command": "prettier --check .",
      "options": {
        "cwd": "apps/web"
      }
    },
    "lint": {
      "command": "eslint . --fix",
      "options": {
        "cwd": "apps/web"
      }
    },
    "lint-check": {
      "command": "eslint .",
      "options": {
        "cwd": "apps/web"
      }
    },
    "type-check": {
      "command": "tsc --noEmit -p tsconfig.json",
      "options": {
        "cwd": "apps/web"
      }
    },
    "test": {
      "command": "vitest run",
      "options": {
        "cwd": "apps/web"
      }
    },
    "knip": {
      "command": "knip --workspace apps/web",
      "options": {
        "cwd": "."
      }
    },
    "fix": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run {projectName}:format",
          "nx run {projectName}:lint",
          "nx run {projectName}:type-check",
          "nx run {projectName}:test"
        ],
        "parallel": false
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run {projectName}:format-check",
          "nx run {projectName}:lint-check",
          "nx run {projectName}:type-check",
          "nx run {projectName}:test",
          "nx run {projectName}:knip"
        ],
        "parallel": false
      }
    },
    "e2e": {
      "command": "playwright test",
      "options": {
        "cwd": "apps/web"
      }
    }
  }
}
