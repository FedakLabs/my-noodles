# Copy to `.env` (gitignored). Restart Vite after changes.

# Required
VITE_API_URL=http://localhost:3001
VITE_AUTH_API_URL=http://localhost:3001

# Optional — browser error reporting off when unset
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Optional — Sentry release tag (CI sets from git sha)
# VITE_APP_VERSION=dev
