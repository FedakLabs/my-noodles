{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "dev": {
      "command": "pnpm dev",
      "options": {
        "cwd": "apps/api"
      }
    },
    "build": {
      "command": "pnpm build",
      "dependsOn": [
        { "projects": "api-lib", "target": "build" },
        { "projects": "utils", "target": "build" }
      ],
      "options": {
        "cwd": "apps/api"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "generate:openapi": {
      "command": "pnpm generate:openapi",
      "dependsOn": [
        { "projects": "api-lib", "target": "build" },
        { "projects": "utils", "target": "build" }
      ],
      "options": {
        "cwd": "apps/api"
      },
      "outputs": ["{projectRoot}/src/openapi/openapi.json"]
    },
    "format": {
      "command": "pnpm format",
      "options": {
        "cwd": "apps/api"
      }
    },
    "format-check": {
      "command": "pnpm format-check",
      "options": {
        "cwd": "apps/api"
      }
    },
    "lint": {
      "command": "pnpm lint",
      "dependsOn": [
        { "projects": "api-lib", "target": "build" },
        { "projects": "utils", "target": "build" }
      ],
      "options": {
        "cwd": "apps/api"
      }
    },
    "lint-check": {
      "command": "pnpm lint-check",
      "dependsOn": [
        { "projects": "api-lib", "target": "build" },
        { "projects": "utils", "target": "build" }
      ],
      "options": {
        "cwd": "apps/api"
      }
    },
    "type-check": {
      "command": "pnpm type-check",
      "dependsOn": [
        { "projects": "api-lib", "target": "build" },
        { "projects": "utils", "target": "build" }
      ],
      "options": {
        "cwd": "apps/api"
      }
    },
    "test": {
      "command": "pnpm test",
      "dependsOn": [
        { "projects": "api-lib", "target": "build" },
        { "projects": "utils", "target": "build" }
      ],
      "options": {
        "cwd": "apps/api"
      }
    },
    "knip": {
      "command": "knip --config configs/knip/knip.json --workspace apps/api",
      "options": {
        "cwd": "."
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        { "projects": "api-lib", "target": "build" },
        { "projects": "utils", "target": "build" }
      ],
      "options": {
        "cwd": ".",
        "commands": [
          "pnpm --dir apps/api format",
          "pnpm --dir apps/api lint",
          "pnpm --dir apps/api type-check",
          "pnpm --dir apps/api test",
          "knip --config configs/knip/knip.json --workspace apps/api"
        ],
        "parallel": false
      }
    },
    "migration:run": {
      "command": "pnpm migration:run",
      "options": {
        "cwd": "apps/api"
      }
    },
    "migration:revert": {
      "command": "pnpm migration:revert",
      "options": {
        "cwd": "apps/api"
      }
    },
    "seed": {
      "command": "pnpm seed",
      "options": {
        "cwd": "apps/api"
      }
    }
  }
}
