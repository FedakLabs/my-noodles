{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "dev": {
      "command": "pnpm dev",
      "options": {
        "cwd": "apps/api"
      }
    },
    "build": {
      "command": "pnpm build",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/api"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "generate:openapi": {
      "command": "pnpm generate:openapi",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/api"
      },
      "outputs": ["{projectRoot}/src/openapi/openapi.json"]
    },
    "format": {
      "command": "pnpm format",
      "options": {
        "cwd": "apps/api"
      }
    },
    "format-check": {
      "command": "pnpm format-check",
      "options": {
        "cwd": "apps/api"
      }
    },
    "lint": {
      "command": "pnpm lint",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/api"
      }
    },
    "lint-check": {
      "command": "pnpm lint-check",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/api"
      }
    },
    "type-check": {
      "command": "pnpm type-check",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/api"
      }
    },
    "test": {
      "command": "pnpm test",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/api"
      }
    },
    "knip": {},
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "commands": [
          "nx run api:format",
          "nx run api:lint",
          "nx run api:type-check",
          "nx run api:test",
          "nx run api:knip"
        ],
        "parallel": false
      }
    },
    "migration:run": {
      "command": "pnpm migration:run",
      "options": {
        "cwd": "apps/api"
      }
    },
    "migration:revert": {
      "command": "pnpm migration:revert",
      "options": {
        "cwd": "apps/api"
      }
    },
    "seed": {
      "command": "pnpm seed",
      "options": {
        "cwd": "apps/api"
      }
    }
  }
}
