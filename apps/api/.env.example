# Postgres (docker-compose defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=my_noodles
POSTGRES_PASSWORD=my_noodles
POSTGRES_DB=my_noodles
# Log SQL queries to stdout (default: false)
# DATABASE_LOGGING=true

# Server
PORT=3001
# local | dev | prod — selects `.env.{NODE_ENV}` layered on top of this file
NODE_ENV=local
APP_NAME=my-noodles-api
APP_VERSION=dev

# Artificial latency on storefront routes (ms) — local/dev only; health/docs are skipped
# API_RESPONSE_DELAY_MS=1500

# Env layering (later overrides earlier): `.env` → `.env.{NODE_ENV}` → `.env.local`
# `.env.local` is gitignored — use for personal secrets and machine-specific overrides.

# Graceful shutdown — max time to drain in-flight requests before force exit (ms)
SHUTDOWN_TIMEOUT_MS=30000

# OpenTelemetry (opt-in — enable with docker compose --profile observability up)
OTEL_ENABLED=false
# Required when OTEL_ENABLED=true:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=my-noodles-api

# Telegram (Phase 5)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
