# Env layering (later overrides earlier): `.env` → `.env.{NODE_ENV}` → `.env.local`
# `.env.local` is gitignored — use for personal secrets and machine-specific overrides.
# Full external setup checklist: docs/requirements.md

# --- Server ---
PORT=3001
# local | dev | prod — selects `.env.{NODE_ENV}` layered on top of this file
NODE_ENV=local
APP_NAME=my-noodles-api
APP_VERSION=dev
# API_RESPONSE_DELAY_MS=1500
SHUTDOWN_TIMEOUT_MS=30000

# --- Database ---
# Local: discrete POSTGRES_* (matches root docker-compose.yml).
# Prod (Neon): set DATABASE_URL instead (pooled for runtime; DATABASE_URL_DIRECT for CI migrations).
# Prefer sslmode=require&channel_binding=require&connect_timeout=10 on Neon URLs.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=my_noodles
POSTGRES_PASSWORD=my_noodles
POSTGRES_DB=my_noodles
# DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=10
# DATABASE_SSL=true
# DATABASE_LOGGING=true

# --- Observability (optional) ---
# When OTEL_ENABLED=true, endpoint + service name are required by API Config.
# OTEL_EXPORTER_OTLP_HEADERS is read by the OTEL SDK (not Nest Config); local LGTM needs no headers.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=my-noodles-api
# OTEL_EXPORTER_OTLP_HEADERS=

# When SENTRY_ENABLED=true, SENTRY_DSN is required by API Config.
SENTRY_ENABLED=false
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# --- Telegram (required — API fails fast at boot if missing) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tawk.to (required — HMAC stays server-side; property/widget returned by POST /support/sessions) ---
TAWK_API_KEY=
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=

# --- Admin auth (code has local defaults if unset; set explicitly for non-local) ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
ADMIN_EMAIL=admin@my-noodles.local
ADMIN_PASSWORD=changeme123

# --- Delivery ---
# NOVA_POSHTA_API_KEY required at boot; base URLs optional (code defaults below).
NOVA_POSHTA_API_KEY=
# NOVA_POSHTA_API_BASE_URL=https://api.novaposhta.ua/v2.0/json/
# UKRPOSHTA_API_BASE_URL=https://ukrposhta.ua/address-classifier-ws
# MEEST_API_BASE_URL=https://publicapi.meest.com

# --- Object storage / CDN (infra-ready — bootstrapped on prod VM; Nest does not read these yet) ---
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=fsn1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=my-noodles-media
# CDN_PUBLIC_BASE_URL=https://cdn.mynoodles.shop
