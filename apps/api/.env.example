# Env layering (later overrides earlier): `.env` → `.env.{NODE_ENV}` → `.env.local`
# `.env.local` is gitignored — use for personal secrets and machine-specific overrides.

# Server
PORT=3001
# local | dev | prod — selects `.env.{NODE_ENV}` layered on top of this file
NODE_ENV=local
APP_NAME=my-noodles-api
APP_VERSION=dev
# API_RESPONSE_DELAY_MS=1500
SHUTDOWN_TIMEOUT_MS=30000

# Postgres (required)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=my_noodles
POSTGRES_PASSWORD=my_noodles
POSTGRES_DB=my_noodles
# DATABASE_LOGGING=true

# OpenTelemetry (optional — OTEL_* endpoint/service required only when enabled)
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=my-noodles-api

# Telegram (required — API fails fast at boot if missing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tawk.to (required — HMAC stays server-side; property/widget returned by POST /support/sessions)
TAWK_API_KEY=
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=

# Admin auth (has local defaults in code; set explicitly for non-local)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
ADMIN_EMAIL=admin@my-noodles.local
ADMIN_PASSWORD=changeme123

# Delivery (NOVA_POSHTA_API_KEY required; base URLs optional with code defaults)
NOVA_POSHTA_API_KEY=
# NOVA_POSHTA_API_BASE_URL=https://api.novaposhta.ua/v2.0/json
# UKRPOSHTA_API_BASE_URL=https://ukrposhta.ua/address-classifier-ws
# MEEST_API_BASE_URL=https://publicapi.meest.com
