{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --watch ../../libs/api/src --ext ts,json --exec \"pnpm --dir ../../libs/api build && pnpm build && pnpm start\"",
    "build": "nest build --config nest-cli.json && tsc-alias -p tsconfig.build.json",
    "start": "node --import=./dist/instrumentation.js dist/index.js",
    "generate:openapi": "pnpm build && node dist/openapi/generate-openapi.js",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint-check": "oxlint",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "migration:run": "tsx src/infrastructure/migrations/scripts/run.ts",
    "migration:revert": "tsx src/infrastructure/migrations/scripts/revert.ts",
    "seed": "tsx src/infrastructure/seed/seed.ts"
  },
  "dependencies": {
    "@my-noodles/api-lib": "workspace:*",
    "@my-noodles/integration-api-clients": "workspace:*",
    "@my-noodles/locale": "workspace:*",
    "@my-noodles/translit": "workspace:*",
    "@my-noodles/utils": "workspace:*",
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/schedule": "6.1.1",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "pg": "8.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@my-noodles/jest-config": "workspace:*",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "11.1.27",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/express-serve-static-core": "5.0.7",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.3",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "7.1.0",
    "ts-jest": "29.3.2",
    "tsc-alias": "1.8.16",
    "tsx": "4.19.4"
  }
}
