# Postgres (docker-compose defaults)
DATABASE_URL=postgresql://my_noodles:my_noodles@localhost:5432/my_noodles

# API
PORT=3001

# OpenTelemetry (opt-in — enable with docker compose --profile observability up)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=my-noodles-api

# Telegram (Phase 5)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
