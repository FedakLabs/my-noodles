        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([Користувач на сайті]) --&gt; CheckSession{Є сесія?}\n    CheckSession -- Ні --&gt; CreateSession[Створити сесію]\n    CheckSession -- Так --&gt; GetCart[Отримати корзину]\n    CreateSession --&gt; GetCart\n    \n    GetCart --&gt; CheckCart{Корзина існує?}\n    CheckCart -- Ні --&gt; NewCart[Створити нову корзину]\n    CheckCart -- Так --&gt; ShowCart[Відобразити корзину]\n    NewCart --&gt; ShowCart\n    \n    ShowCart --&gt; Browse{Вибір товарів}\n    Browse --&gt; Catalog[Каталог товарів]\n    Browse --&gt; Feed[Стрічка товарів]\n    \n    Catalog --&gt; AddToCart[Додати товар]\n    Feed --&gt; AddToCart\n    \n    AddToCart --&gt; CheckInv{Доступно в інвентарі?}\n    CheckInv -- Ні --&gt; ErrorInv[Помилка: недостатньо товару]\n    CheckInv -- Так --&gt; UpdateCart[Товар додано до корзини]\n    ErrorInv --&gt; ShowCart\n    UpdateCart --&gt; ShowCart\n    \n    ShowCart --&gt; OpenCheckout[Відкрити деталі корзини]\n    \n    OpenCheckout --&gt; HasPending{Є активне замовлення?}\n    HasPending -- Так --&gt; PendingOptions{Вибір дії}\n    PendingOptions --&gt;|aa| Continue[Продовжити дооформлення]\n    PendingOptions --&gt;|ab| Merge[Додати товари до замовлення]\n    PendingOptions --&gt;|ac| Cancel[Скасувати оформлення]\n    \n    HasPending -- Ні --&gt; StartCheckout[Почати оформлення]\n    \n    StartCheckout --&gt; CheckStock[Перевірка доступності]\n    CheckStock --&gt; StockResult{Достатньо?}\n    StockResult -- Ні --&gt; ErrorStock[Помилка: змінилася кількість]\n    ErrorStock --&gt; ShowCart\n    StockResult -- Так --&gt; CreateOrder[Створити оформлення]\n    \n    CreateOrder --&gt; FillDetails[Введення деталей: отримувач, доставка, оплата]\n    FillDetails --&gt; Confirm[Підтвердити оформлення]\n    Confirm --&gt; FinalCheck{Перевірка складу}\n    \n    FinalCheck -- Зміни --&gt; ErrorFinal[Помилка: кількість змінилася]\n    ErrorFinal --&gt; FillDetails\n    FinalCheck -- OK --&gt; Success[Замовлення створено: status=new]\n    \n    Cancel --&gt; ReturnToCart[Товари повернуто в корзину]\n    ReturnToCart --&gt; ShowCart\n    \n    subgraph Background\n    Clock[Clock Ticking] --&gt; ExpireCheck{status=pending &amp; expired?}\n    ExpireCheck -- Так --&gt; AutoCancel[status=canceled, reason=expired]\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="H4icGwtAyobcz7qWVbl4-1">
