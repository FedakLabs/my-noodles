{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/.oxlintrc.json"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/configs/typescript/*.json",
      "{workspaceRoot}/.oxlintrc.json",
      "{workspaceRoot}/.oxfmtrc.json",
      "{workspaceRoot}/configs/knip/knip.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "format": {
      "inputs": ["default", "{workspaceRoot}/.oxfmtrc.json"],
      "cache": false
    },
    "format-check": {
      "inputs": ["default", "{workspaceRoot}/.oxfmtrc.json"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json", "{projectRoot}/.oxlintrc.json"],
      "cache": false
    },
    "lint-check": {
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json", "{projectRoot}/.oxlintrc.json"],
      "cache": true
    },
    "type-check": {
      "inputs": ["default", "^default"],
      "cache": true
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/configs/vitest/**",
        "{workspaceRoot}/configs/vite/**",
        "{workspaceRoot}/configs/jest/**"
      ],
      "cache": true
    },
    "knip": {
      "executor": "nx:run-commands",
      "options": {
        "command": "knip --config configs/knip/knip.json --workspace {projectRoot}",
        "cwd": "."
      },
      "inputs": ["default", "{workspaceRoot}/configs/knip/knip.json"],
      "cache": true
    }
  },
  "analytics": true
}
