{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/**/~*.test.[jt]s?(x)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/eslint.config.mjs"
    ],
    "sharedGlobals": ["{workspaceRoot}/configs/typescript/base.json"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "format": {
      "inputs": [
        "default",
        "{workspaceRoot}/configs/prettier/.prettierrc.json",
        "{workspaceRoot}/configs/prettier/.prettierignore"
      ],
      "cache": false
    },
    "format-check": {
      "inputs": [
        "default",
        "{workspaceRoot}/configs/prettier/.prettierrc.json",
        "{workspaceRoot}/configs/prettier/.prettierignore"
      ],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/configs/eslint/**"],
      "cache": false
    },
    "lint-check": {
      "inputs": ["default", "{workspaceRoot}/configs/eslint/**"],
      "cache": true
    },
    "type-check": {
      "inputs": ["default", "^default"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^default"],
      "cache": true
    },
    "knip": {
      "inputs": ["default", "{workspaceRoot}/configs/knip/knip.json"],
      "cache": true
    }
  },
  "analytics": true
}
