{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["eslint-config-prettier", "@commitlint/config-conventional"],
  "ignoreBinaries": [
    "api:generate",
    "build",
    "build-storybook",
    "dev",
    "e2e",
    "format",
    "format-check",
    "generate:clients",
    "lint",
    "lint-check",
    "migration:revert",
    "migration:run",
    "seed",
    "storybook",
    "test",
    "type-check"
  ],
  "workspaces": {
    "apps/web": {
      "entry": ["next.config.ts", "src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "vitest.config.ts", "playwright.config.ts"],
      "ignoreDependencies": [
        "@svgr/webpack",
        "@next/third-parties",
        "@tanstack/react-query",
        "motion",
        "next-intl",
        "nuqs",
        "react-hook-form",
        "zod",
        "zustand"
      ]
    },
    "apps/api": {
      "entry": [
        "src/index.ts",
        "src/instrumentation.ts",
        "src/openapi/generate-openapi.ts",
        "src/infrastructure/migrations/**/*.ts",
        "src/infrastructure/migrations/scripts/**/*.ts"
      ],
      "project": ["src/**/*.ts", "jest.config.cjs"],
      "ignoreIssues": {
        "src/config.ts": ["exports"],
        "src/application/orders/order-delivery.dto.ts": ["exports"],
        "src/application/products/products.filters.ts": ["exports"],
        "src/application/products/products.dto.ts": ["types"],
        "src/infrastructure/i18n/index.ts": ["exports", "types"],
        "src/infrastructure/i18n/localized-string.ts": ["exports"],
        "src/infrastructure/exceptions/index.ts": ["exports"],
        "src/infrastructure/exceptions/http.exceptions.ts": ["exports"],
        "src/infrastructure/seed/index.ts": ["exports", "types"],
        "src/infrastructure/external-apis/telegram/index.ts": ["exports", "types"],
        "src/infrastructure/external-apis/telegram/telegram.config.ts": ["exports"],
        "src/infrastructure/external-apis/telegram/telegram.dto.ts": ["types"],
        "src/infrastructure/external-apis/meest/index.ts": ["exports"],
        "src/infrastructure/external-apis/meest/meest.config.ts": ["exports"],
        "src/infrastructure/external-apis/nova-poshta/index.ts": ["exports", "types"],
        "src/infrastructure/external-apis/nova-poshta/nova-poshta.api.ts": ["types"],
        "src/infrastructure/external-apis/nova-poshta/nova-poshta.config.ts": ["exports"],
        "src/infrastructure/external-apis/ukrposhta/index.ts": ["exports"],
        "src/infrastructure/external-apis/ukrposhta/ukrposhta.config.ts": ["exports"],
        "src/tests/fixtures/env.ts": ["exports"],
        "src/tests/jest-globals.ts": ["exports"],
        "src/utils/transformers/index.ts": ["exports"]
      },
      "ignoreDependencies": [
        "@nestjs/swagger",
        "@nestjs/throttler",
        "@nestjs/typeorm",
        "pg",
        "typeorm",
        "winston",
        "tsx",
        "@types/express-serve-static-core"
      ]
    },
    "packages/theme": {
      "entry": [
        "src/index.ts",
        ".storybook/main.ts",
        ".storybook/preview.tsx",
        "src/stories/**/*.stories.tsx",
        "src/stories/**/*.mdx"
      ],
      "project": [
        "src/**/*.{ts,tsx,mdx}",
        ".storybook/**/*.{ts,tsx}",
        "vitest.config.ts"
      ],
      "ignore": ["src/css.d.ts"],
      "ignoreIssues": {
        "src/index.ts": ["exports"],
        "src/stories/storyCatalog.ts": ["exports", "types"]
      }
    },
    "packages/ui": {
      "entry": [
        "src/index.ts",
        ".storybook/main.ts",
        ".storybook/preview.tsx",
        "src/stories/**/*.stories.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}", ".storybook/**/*.{ts,tsx}", "vitest.config.ts"],
      "ignoreIssues": {
        "src/index.ts": ["exports"]
      },
      "ignoreDependencies": ["@emotion/react", "@emotion/styled", "@mui/material"]
    },
    "packages/api-clients": {
      "entry": ["src/index.ts", "openapi-ts.config.ts"],
      "project": ["src/**/*.ts", "openapi-ts.config.ts"],
      "ignore": ["src/**/generated/**"]
    },
    "libs/web": {
      "entry": ["src/index.ts", "src/hooks/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@tanstack/react-query", "react"]
    },
    "libs/api": {
      "entry": [
        "src/index.ts",
        "src/config/index.ts",
        "src/context/index.ts",
        "src/pagination/index.ts",
        "src/persistence/index.ts",
        "src/external-api/index.ts",
        "src/exceptions/index.ts",
        "src/logging/index.ts",
        "src/otel/index.ts",
        "src/utils/index.ts",
        "src/middlewares/index.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignore": [
        "src/external-api/logger.ts"
      ],
      "ignoreIssues": {
        "src/config/config.ts": ["exports"],
        "src/config/env.ts": ["exports"],
        "src/logging/manifest-log.ts": ["exports"],
        "src/middlewares/client-baggage.ts": ["exports"]
      },
      "ignoreDependencies": ["typeorm", "@types/express-serve-static-core"]
    }
  }
}
