{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@commitlint/config-conventional"],
  "ignoreBinaries": [
    "api:generate",
    "build",
    "build-storybook",
    "dev",
    "e2e",
    "format",
    "format-check",
    "generate:clients",
    "lint",
    "lint-check",
    "migration:revert",
    "migration:run",
    "seed",
    "storybook",
    "test",
    "type-check"
  ],
  "workspaces": {
    "apps/admin": {
      "entry": ["index.html", "src/main.tsx", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "vite.config.ts", "vitest.config.ts"],
      "ignoreDependencies": ["@emotion/react", "@emotion/styled", "@mui/material"]
    },
    "apps/web": {
      "entry": [
        "next.config.ts",
        "src/**/*.{ts,tsx}",
        "playwright.config.ts",
        "e2e/mock-api.ts",
        "e2e/**/*.spec.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "vitest.config.ts", "playwright.config.ts"],
      "ignoreDependencies": [
        "@svgr/webpack",
        "@next/third-parties",
        "@tanstack/react-query",
        "motion",
        "next-intl",
        "nuqs",
        "react-hook-form",
        "zod",
        "zustand"
      ]
    },
    "apps/api": {
      "entry": [
        "src/index.ts",
        "src/instrumentation.ts",
        "src/openapi/generate-openapi.ts",
        "src/infrastructure/migrations/**/*.ts",
        "src/infrastructure/migrations/scripts/**/*.ts"
      ],
      "project": ["src/**/*.ts", "jest.config.cjs"],
      "ignoreIssues": {
        "src/config.ts": ["exports"],
        "src/application/orders/order-delivery.dto.ts": ["exports"],
        "src/application/products/products.filters.ts": ["exports"],
        "src/application/products/products.dto.ts": ["types"],
        "src/infrastructure/seed/index.ts": ["exports", "types"],
        "src/application/telegram/index.ts": ["exports", "types"],
        "src/application/telegram/telegram.config.ts": ["exports"],
        "src/application/support/providers/tawk-support.config.ts": ["exports"],
        "src/application/meest/index.ts": ["exports"],
        "src/application/meest/meest.config.ts": ["exports"],
        "src/application/nova-poshta/index.ts": ["exports", "types"],
        "src/application/nova-poshta/nova-poshta.config.ts": ["exports"],
        "src/application/ukrposhta/index.ts": ["exports"],
        "src/application/ukrposhta/ukrposhta.config.ts": ["exports"],
        "src/tests/fixtures/env.ts": ["exports"],
        "src/tests/jest-globals.ts": ["exports"]
      },
      "ignoreDependencies": [
        "@nestjs/swagger",
        "@nestjs/throttler",
        "@nestjs/typeorm",
        "pg",
        "typeorm",
        "winston",
        "tsx",
        "@types/express-serve-static-core"
      ]
    },
    "packages/theme": {
      "entry": [
        "src/index.ts",
        ".storybook/main.ts",
        ".storybook/preview.tsx",
        "src/stories/**/*.stories.tsx",
        "src/stories/**/*.mdx"
      ],
      "project": ["src/**/*.{ts,tsx,mdx}", ".storybook/**/*.{ts,tsx}", "vitest.config.ts"],
      "ignore": ["src/css.d.ts"],
      "ignoreIssues": {
        "src/index.ts": ["exports"],
        "src/stories/storyCatalog.ts": ["exports", "types"]
      }
    },
    "packages/ui": {
      "entry": [
        "src/index.ts",
        ".storybook/main.ts",
        ".storybook/preview.tsx",
        "src/stories/**/*.stories.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}", ".storybook/**/*.{ts,tsx}", "vitest.config.ts"],
      "ignoreIssues": {
        "src/index.ts": ["exports"]
      },
      "ignoreDependencies": ["@emotion/react", "@emotion/styled", "@mui/material"]
    },
    "packages/api-clients": {
      "entry": [
        "src/index.ts",
        "src/storefront/index.ts",
        "src/storefront/openapi-ts.config.ts",
        "src/admin/index.ts",
        "src/admin/openapi-ts.config.ts",
        "src/auth/index.ts",
        "src/auth/openapi-ts.config.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignore": ["src/**/generated/**"]
    },
    "packages/integration-api-clients": {
      "entry": [
        "src/meest/index.ts",
        "src/nova-poshta/index.ts",
        "src/ukrposhta/index.ts",
        "src/telegram/index.ts",
        "src/meest/client/openapi-ts.config.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignore": ["src/**/generated/**"]
    },
    "packages/utils": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "libs/locale": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "libs/web": {
      "entry": ["src/index.ts", "src/hooks/deadline-countdown/index.ts", "src/validators/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@tanstack/react-query", "react"]
    },
    "libs/translit": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "libs/api": {
      "entry": [
        "src/index.ts",
        "src/config/index.ts",
        "src/context/index.ts",
        "src/pagination/index.ts",
        "src/persistence/index.ts",
        "src/api-client/index.ts",
        "src/cache/index.ts",
        "src/exceptions/index.ts",
        "src/logger/index.ts",
        "src/otel/index.ts",
        "src/utils/index.ts",
        "src/transformers/index.ts",
        "src/validators/index.ts",
        "src/locale/index.ts",
        "src/auth/index.ts",
        "src/nest/index.ts",
        "src/nest/auth/index.ts",
        "src/express/index.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignore": ["src/api-client/logger.ts"],
      "ignoreIssues": {
        "src/config/config.ts": ["exports"],
        "src/config/env.ts": ["exports"],
        "src/logger/manifest-log.ts": ["exports"],
        "src/locale/index.ts": ["exports", "types"],
        "src/locale/localized-string.ts": ["exports"]
      },
      "ignoreDependencies": [
        "typeorm",
        "@types/express-serve-static-core",
        "@nestjs/common",
        "@nestjs/core",
        "@nestjs/swagger",
        "@nestjs/throttler",
        "@nestjs/typeorm",
        "rxjs"
      ]
    }
  }
}
