{
  "name": "@my-noodles/web-lib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./context": {
      "types": "./src/context/index.ts",
      "import": "./src/context/index.ts",
      "default": "./src/context/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "import": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./react-query": {
      "types": "./src/react-query/index.ts",
      "import": "./src/react-query/index.ts",
      "default": "./src/react-query/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write . --ignore-path ../../configs/prettier/.prettierignore",
    "format-check": "prettier --check . --ignore-path ../../configs/prettier/.prettierignore",
    "lint": "eslint . --fix",
    "lint-check": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@my-noodles/eslint-config": "workspace:*",
    "@tanstack/react-query": "5.101.0",
    "@types/node": "22.15.3",
    "@types/react": "^19.0.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "react": "^19.0.0"
  }
}
