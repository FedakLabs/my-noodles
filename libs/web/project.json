{
  "name": "web-lib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/src",
  "projectType": "library",
  "tags": ["scope:libs", "type:lib", "platform:web"],
  "targets": {
    "build": {
      "command": "pnpm build",
      "options": {
        "cwd": "libs/web"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "format": {
      "command": "pnpm format",
      "options": {
        "cwd": "libs/web"
      }
    },
    "format-check": {
      "command": "pnpm format-check",
      "options": {
        "cwd": "libs/web"
      }
    },
    "lint": {
      "command": "pnpm lint",
      "options": {
        "cwd": "libs/web"
      }
    },
    "lint-check": {
      "command": "pnpm lint-check",
      "options": {
        "cwd": "libs/web"
      }
    },
    "type-check": {
      "command": "pnpm type-check",
      "options": {
        "cwd": "libs/web"
      }
    },
    "knip": {},
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "commands": [
          "nx run web-lib:format",
          "nx run web-lib:lint",
          "nx run web-lib:type-check",
          "nx run web-lib:knip"
        ],
        "parallel": false
      }
    }
  }
}
