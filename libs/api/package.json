{
  "name": "@my-noodles/api-lib",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "default": "./dist/context/index.js"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.ts",
      "default": "./dist/pagination/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "default": "./dist/persistence/index.js"
    },
    "./external-api": {
      "types": "./dist/external-api/index.d.ts",
      "default": "./dist/external-api/index.js"
    },
    "./exceptions": {
      "types": "./dist/exceptions/index.d.ts",
      "default": "./dist/exceptions/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "default": "./dist/logging/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./middlewares": {
      "types": "./dist/middlewares/index.d.ts",
      "default": "./dist/middlewares/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write . --ignore-path ../../configs/prettier/.prettierignore",
    "format-check": "prettier --check . --ignore-path ../../configs/prettier/.prettierignore",
    "lint": "eslint . --fix",
    "lint-check": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.77.0",
    "@opentelemetry/instrumentation-winston": "0.63.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "@opentelemetry/winston-transport": "0.29.0",
    "axios": "1.9.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "16.4.7",
    "http-status-codes": "^2.3.0",
    "winston": "3.19.0"
  },
  "peerDependencies": {
    "typeorm": "^0.3.0 || ^1.0.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@my-noodles/eslint-config": "workspace:*",
    "@my-noodles/jest-config": "workspace:*",
    "@types/express": "5.0.3",
    "@types/express-serve-static-core": "5.0.7",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.3",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "reflect-metadata": "0.2.2",
    "ts-jest": "29.3.2",
    "typeorm": "1.0.0"
  }
}
