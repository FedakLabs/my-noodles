    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@my-noodles/jest-config": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.3",
    "jest": "29.7.0",
    "ts-jest": "29.3.2"
  }
}
