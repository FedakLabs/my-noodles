{
  "name": "my-noodles",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "11.8.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "prepare": "husky",
    "dev:web": "nx run web:dev",
    "dev:admin": "nx run admin:dev",
    "dev:api": "nx run api:dev",
    "dev:ui": "nx run ui:storybook",
    "build": "nx run-many -t build",
    "format": "oxfmt",
    "validate": "nx run-many -t validate && nx run web:e2e",
    "tofu:plan": "gh workflow run infra.yml -f action=plan -f ref=main",
    "tofu:apply": "gh workflow run infra.yml -f action=apply -f ref=main",
    "tofu:fmt": "tofu fmt -recursive devops/tofu",
    "tofu:validate": "tofu -chdir=devops/tofu/envs/prod init -backend=false -input=false && tofu -chdir=devops/tofu/envs/prod validate",
    "deploy:web": "pnpm --dir apps/web deploy",
    "deploy:admin": "wrangler deploy --config=devops/cloudflare/admin/wrangler.jsonc",
    "deploy:api": "wrangler deploy --config=devops/cloudflare/api/wrangler.jsonc"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@cloudflare/containers": "^0.0.25",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@playwright/test": "1.61.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.3",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "knip": "6.17.1",
    "lint-staged": "17.0.8",
    "nx": "23.0.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.24.0",
    "wrangler": "^4.35.0",
    "typescript": "6.0.3"
  }
}
