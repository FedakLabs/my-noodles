{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 110,
  "tabWidth": 2,
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "**/dist/**",
    ".next",
    "out",
    "coverage",
    ".nx",
    "pnpm-lock.yaml",
    "**/generated/**"
  ]
}
