pnpm commitlint --config configs/commitlint/commitlint.config.mjs --edit "$1" || {
  msg=$(head -n 1 "$1")

  echo ""
  echo "Commit message format:"
  echo "  <type>(<optional scope>): <subject>"
  echo ""
  echo "Examples:"
  echo "  chore: bootstrap nx monorepo (phase 0 & phase 1)"
  echo "  feat(web): add product card to catalog"
  echo "  fix(api): handle missing product slug"
  echo "  docs: update mvp implementation plan"
  echo ""
  echo "Validate draft: pnpm exec commitlint --config configs/commitlint/commitlint.config.mjs --edit .git/COMMIT_EDITMSG_DRAFT"

  exit 1
}
